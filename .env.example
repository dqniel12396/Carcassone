# Server Port (Default: 3080)
PORT=3080

# Environment Mode (production / development)
NODE_ENV=production

# Admin API & Security Token (Optional custom secret)
ADMIN_TOKEN=medieval_secret_admin_token_change_me

# Gemini AI Integration (Optional for AI bot self-training & smart commentary)
# GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Alerts Integration (Optional for CasaOS server status monitoring)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here
